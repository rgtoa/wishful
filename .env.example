# Client config. Copy to .env.local for dev, or set in your hosting dashboard.
# Leave VITE_API_URL empty to run the app fully local (no sync, no push).

# Base URL of your deployed Wishful backend (the Deno Deploy project URL).
VITE_API_URL=

# Public VAPID key — must match the keypair set on the backend.
# Generate with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
