{
  // Serve the built PWA as static assets from a Cloudflare Worker.
  // `npm run build` produces ./dist, and `npx wrangler deploy` uploads it.
  "name": "wishful",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
